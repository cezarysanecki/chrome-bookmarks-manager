{
  "manifest_version": 3,
  "name": "Ponad Kodem — Zakładki",
  "version": "1.0.1",
  "key": "",
  "description": "Przeglądaj i wyszukuj zakładki Chrome z podglądem tytułu i URL.",
  "permissions": ["bookmarks", "tabs", "storage"],
  "host_permissions": ["https://www.google.com/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "Alt+Shift+B"
      },
      "description": "Otwórz zakładki Ponad Kodem"
    },
    "add-bookmark": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Dodaj zakładkę do bieżącej strony"
    }
  },
  "minimum_chrome_version": "91",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
